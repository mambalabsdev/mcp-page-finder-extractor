{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.mambabuilt/mcp-page-finder-extractor",
  "description": "Find a named page type on a company's own website from its domain, in 11 languages.",
  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/mambalabsdev/mcp-page-finder-extractor",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mambalabsdev/mcp-page-finder-extractor",
      "version": "1.0.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "Apify API token from https://console.apify.com/account/integrations",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
